{
  "name": "jira-pebble",
  "author": "Brian Meeker",
  "version": "0.1.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  },
  "pebble": {
    "displayName": "Jira",
    "uuid": "250203db-957c-4b1f-9116-075ea289d4c5",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "capabilities": [
      "configurable"
    ],
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "atlassian.net"
          ]
        },
        "reason": "To find your Jira site",
        "required": true
      },
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.atlassian.com"
          ]
        },
        "reason": "To load your Jira issues",
        "required": true
      }
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "Error",
      "SprintName",
      "SprintDaysLeft",
      "ColumnTotal",
      "ColumnIndex",
      "ColumnName",
      "ColumnIssues",
      "ColumnCategory",
      "RequestColumn",
      "ListColumn",
      "ListCount",
      "IssueIndex",
      "IssueKey",
      "IssueSummary",
      "IssueStatus",
      "IssueCategory",
      "IssuePriority",
      "IssueAssignee",
      "IssueUrgent"
    ],
    "resources": {
      "media": []
    }
  }
}
